PORT=5000
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
GEMINI_KEYS=
GROQ_KEYS=
NEWSDATA_KEYS=
GNEWS_KEYS=

# Weekly portfolio email (Resend, https://resend.com). Without RESEND_API_KEY the email can be previewed but not sent.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend. onboarding@resend.dev only delivers to your own Resend account email.
EMAIL_FROM=OptiFolio <onboarding@resend.dev>
# Public URL of the app, used for links in the email.
APP_URL=http://localhost:3000
# Public URL of this backend, used for the unsubscribe link.
API_URL=http://localhost:5000
# Protects POST /api/emails/weekly/run for external schedulers (send it as the x-cron-secret header).
CRON_SECRET=
